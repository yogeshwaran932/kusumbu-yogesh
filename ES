// ==================== PROGRAM 4 ====================
// INTERRUPT HANDLING USING LPC2148 ARM7
// Keil ARM compiler syntax

#include <LPC214x.h>

__irq void EINT2_ISR(void)
{
    IO1PIN ^= (1U << 16);

    EXTINT = (1U << 2);   // Clear EINT2 flag
    VICVectAddr = 0;      // End interrupt
}

void EINT2_Init(void)
{
    PINSEL0 &= ~(3U << 30);
    PINSEL0 |=  (2U << 30);  // P0.15 = EINT2

    IODIR0 &= ~(1U << 15);
    IODIR1 |=  (1U << 16);

    IO1CLR = (1U << 16);     // LED initially OFF

    EXTMODE |= (1U << 2);    // Edge-triggered
    EXTPOLAR &= ~(1U << 2);  // Falling edge

    EXTINT = (1U << 2);

    VICIntSelect &= ~(1U << 16);
    VICVectAddr0 = (unsigned long)EINT2_ISR;
    VICVectCntl0 = (1U << 5) | 16U;

    VICIntEnable = (1U << 16);
}

int main(void)
{
    EINT2_Init();

    while (1)
    {
        // Wait for external interrupt
    }
}







// ==================== PROGRAM 6 ====================
// SENSOR DATA MONITORING - MQTT LAB MANUAL PROGRAM

int sensorPin = A0;
int ledPin = 13;
int sensorValue = 0;

void setup()
{
    pinMode(ledPin, OUTPUT);

    Serial.begin(9600);
    Serial.println("IoT Sensor Simulation Started");
}

void loop()
{
    sensorValue = analogRead(sensorPin);

    Serial.print("Sensor Value: ");
    Serial.println(sensorValue);

    if (sensorValue > 500)
    {
        digitalWrite(ledPin, HIGH);
    }
    else
    {
        digitalWrite(ledPin, LOW);
    }

    delay(1000);
}


// ==================== PROGRAM 7 ====================
// MULTIPLE TASKS WITH DIFFERENT INTERVALS
// The supplied program simulates task scheduling using millis().

unsigned long t1 = 0;
unsigned long t2 = 0;
unsigned long t3 = 0;

void setup()
{
    pinMode(2, OUTPUT);
    pinMode(3, OUTPUT);

    Serial.begin(9600);
}

void loop()
{
    unsigned long now = millis();

    // High-frequency task
    if (now - t1 >= 200)
    {
        t1 = now;
        digitalWrite(2, !digitalRead(2));
    }

    // Medium-frequency task
    if (now - t2 >= 1000)
    {
        t2 = now;
        digitalWrite(3, !digitalRead(3));
    }

    // Low-frequency task
    if (now - t3 >= 1500)
    {
        t3 = now;

        int sensorValue = analogRead(A0);
        Serial.println(sensorValue);
    }
}


// ==================== PROGRAM 8 ====================
// PRE-TRAINED LINEAR MODEL FOR CLASSIFICATION

int sensorValue;
float output;
int ledPin = 13;

void setup()
{
    Serial.begin(9600);
    pinMode(ledPin, OUTPUT);
}

void loop()
{
    sensorValue = analogRead(A0);

    output = 0.5 * sensorValue - 200;

    if (output > 0)
    {
        digitalWrite(ledPin, HIGH);  // HOT
    }
    else
    {
        digitalWrite(ledPin, LOW);   // COLD
    }

    Serial.print("Sensor Value: ");
    Serial.print(sensorValue);

    Serial.print(" | Model Output: ");
    Serial.println(output);

    delay(500);
}


// ==================== PROGRAM 9 ====================
// LAMP CONTROLLER USING LDR AND TIMER

int ledPin = 9;
int ldrPin = A0;
int threshold = 500;
int delayTime = 5000;

void setup()
{
    pinMode(ledPin, OUTPUT);
    Serial.begin(9600);
}

void loop()
{
    int ldrValue = analogRead(ldrPin);

    Serial.println(ldrValue);

    if (ldrValue < threshold)
    {
        digitalWrite(ledPin, HIGH);  // Dark: lamp ON
    }
    else
    {
        delay(delayTime);
        digitalWrite(ledPin, LOW);   // Bright: lamp OFF
    }
}




    
// ==================== PROGRAM 1 ====================
// LED BLINKING USING GPIO - LPC2148 ARM7

#include <LPC214x.h>

void delay(void);

int main(void)
{
    IO1DIR |= 0x00FF0000;

    while (1)
    {
        IO1SET = 0x00550000;
        IO1CLR = 0x00AA0000;
        delay();

        IO1SET = 0x00AA0000;
        IO1CLR = 0x00550000;
        delay();
    }
}

void delay(void)
{
    int p, q;

    for (p = 0; p < 10; p++)
    {
        for (q = 0; q < 0x99900; q++);
    }
}


// ==================== PROGRAM 2 ====================
// DC MOTOR / SERVO PWM - LPC2148

#include <LPC214x.h>

void delay(unsigned int t)
{
    unsigned int i, j;

    for (i = 0; i < t; i++)
        for (j = 0; j < 6000; j++);
}

void PWM_Init(void)
{
    PINSEL0 &= ~(3U << 18);
    PINSEL0 |=  (2U << 18);  // P0.9 = PWM6

    PWMPCR = (1U << 14);     // Enable PWM6 output
    PWMMR0 = 1000;           // PWM period
    PWMMR6 = 500;            // Initial duty cycle

    PWMMCR = (1U << 1);      // Reset counter on MR0
    PWMLER = (1U << 0) | (1U << 6);

    PWMTCR = 0x09;            // Enable counter and PWM
}

int main(void)
{
    PWM_Init();

    while (1)
    {
        PWMMR6 = 250;
        PWMLER = (1U << 6);
        delay(3000);

        PWMMR6 = 500;
        PWMLER = (1U << 6);
        delay(3000);

        PWMMR6 = 750;
        PWMLER = (1U << 6);
        delay(3000);
    }
}


// ==================== PROGRAM 3A ====================
// UART COMMUNICATION - NODEMCU 1 TRANSMITTER

#include <SoftwareSerial.h>

SoftwareSerial mySerial(D6, D5);  // RX, TX

void setup()
{
    Serial.begin(9600);
    mySerial.begin(9600);

    Serial.println("NODEMCU 1 READY");
}

void loop()
{
    mySerial.println("Hello from NodeMCU 1");
    Serial.println("Sent: Hello from NodeMCU 1");

    delay(1000);

    if (mySerial.available())
    {
        String data = mySerial.readStringUntil('\n');

        Serial.print("Received: ");
        Serial.println(data);
    }

    delay(500);
}



% PROGRAM 1: ELECTRIC FIELD VECTORS FOR A DIPOLE
clc;
clear;
close all;
k=9e9; q=1e-9; d=1;
[x,y]=meshgrid(-2:0.05:2,-2:0.05:2);
x1=-d/2; y1=0; x2=d/2; y2=0;
r1x=x-x1; r1y=y-y1;
r2x=x-x2; r2y=y-y2;
r1=sqrt(r1x.^2+r1y.^2);
r2=sqrt(r2x.^2+r2y.^2);
r1(r1<0.05)=0.05;
r2(r2<0.05)=0.05;
Ex=k*q*r1x./r1.^3-k*q*r2x./r2.^3;
Ey=k*q*r1y./r1.^3-k*q*r2y./r2.^3;
E=sqrt(Ex.^2+Ey.^2);
Ex=Ex./E; Ey=Ey./E;
figure;
hold on;
streamslice(x,y,Ex,Ey);
plot(x1,y1,'ro','MarkerFaceColor','r','MarkerSize',18);
plot(x2,y2,'bo','MarkerFaceColor','b','MarkerSize',18);
title('Electric Field Vectors for a Dipole');
xlabel('x'); ylabel('y');
axis equal; axis([-2 2 -2 2]); grid on;

% PROGRAM 2: MAGNETIC FIELD AROUND A STRAIGHT WIRE
clc;
clear;
close all;
mu0=4*pi*1e-7; I=10;
[x,y]=meshgrid(-2:0.1:2,-2:0.1:2);
r=sqrt(x.^2+y.^2);
r(r==0)=0.01;
Bx=-mu0*I./(2*pi*r.^2).*y;
By=mu0*I./(2*pi*r.^2).*x;
figure;
quiver(x,y,Bx,By,'r');
title('Magnetic Field Around a Straight Wire');
xlabel('x'); ylabel('y');
axis equal; grid on;

% PROGRAM 3: SELF-INDUCTANCE SIMULATION
clc;
clear;
close all;
L=10e-3; R=10;
V_in=@(t) 5*sin(2*pi*50*t);
t=linspace(0,0.1,1000);
dt=t(2)-t(1);
I=zeros(size(t));
for k=1:length(t)-1
    dI=(V_in(t(k))-R*I(k))/L;
    I(k+1)=I(k)+dI*dt;
end
figure;
plot(t,I,'LineWidth',2);
xlabel('Time (s)');
ylabel('Current (A)');
title('Current Through Inductor');
grid on;

% PROGRAM 4: MUTUAL INDUCTANCE SIMULATION
clc;
clear;
close all;
L1=10e-3; L2=5e-3; M=3e-3;
R1=10; R2=10;
V1=@(t) 5*sin(2*pi*50*t);
t=linspace(0,0.05,1000);
dt=t(2)-t(1);
I1=zeros(size(t)); I2=zeros(size(t));
for k=1:length(t)-1
    dI1=(V1(t(k))-R1*I1(k) ...
        -M/dt*(I2(k)-I2(max(k-1,1))))/L1;
    dI2=(-R2*I2(k) ...
        -M/dt*(I1(k)-I1(max(k-1,1))))/L2;
    I1(k+1)=I1(k)+dI1*dt;
    I2(k+1)=I2(k)+dI2*dt;
end
figure;
plot(t,I1,'b',t,I2,'r--','LineWidth',2);
xlabel('Time (s)');
ylabel('Current (A)');
legend('Primary Coil','Secondary Coil');
title('Mutual Inductance');
grid on;

% PROGRAM 5: FARADAY'S LAW OF ELECTROMAGNETIC INDUCTION
clc;
clear;
close all;
N=100; A=0.01; B0=0.1; f=50;
omega=2*pi*f;
t=linspace(0,0.1,1000);
B=B0*sin(omega*t);
flux=B*A;
emf=-N*diff(flux)./diff(t);
figure;
subplot(2,1,1);
plot(t,flux,'b','LineWidth',2);
title('Magnetic Flux');
xlabel('Time (s)'); ylabel('Flux (Wb)');
grid on;
subplot(2,1,2);
plot(t(1:end-1),emf,'r','LineWidth',2);
title('Induced EMF');
xlabel('Time (s)'); ylabel('EMF (V)');
grid on;

% PROGRAM 6: TRANSMISSION LINE PARAMETERS
clc;
clear;
close all;
L=2e-7; C=1e-11; R=0.5; G=1e-4;
f=linspace(1e6,1e9,500);
w=2*pi*f;
Z0=sqrt((R+1j*w*L)./(G+1j*w*C));
gamma=sqrt((R+1j*w*L).*(G+1j*w*C));
alpha=real(gamma);
beta=imag(gamma);
figure;
subplot(3,1,1);
plot(f/1e6,abs(Z0),'LineWidth',2);
xlabel('Frequency (MHz)');
ylabel('|Z0| (Ohms)');
title('Characteristic Impedance');
grid on;
subplot(3,1,2);
plot(f/1e6,alpha,'r','LineWidth',2);
xlabel('Frequency (MHz)');
ylabel('Attenuation (Np/m)');
title('Attenuation Constant');
grid on;
subplot(3,1,3);
plot(f/1e6,beta,'g','LineWidth',2);
xlabel('Frequency (MHz)');
ylabel('Phase (rad/m)');
title('Phase Constant');
grid on;

% PROGRAM 7: POLARIZATION SIMULATION
clc;
clear;
close all;
t=linspace(0,2*pi,1000);
Ex1=cos(t); Ey1=cos(t);
Ex2=cos(t); Ey2=sin(t);
Ex3=cos(t); Ey3=0.5*sin(t+pi/3);
figure;
subplot(1,3,1);
plot(Ex1,Ey1,'b','LineWidth',2);
title('Linear Polarization');
xlabel('Ex'); ylabel('Ey');
axis equal; grid on;
subplot(1,3,2);
plot(Ex2,Ey2,'r','LineWidth',2);
title('Circular Polarization');
xlabel('Ex'); ylabel('Ey');
axis equal; grid on;
subplot(1,3,3);
plot(Ex3,Ey3,'m','LineWidth',2);
title('Elliptical Polarization');
xlabel('Ex'); ylabel('Ey');
axis equal; grid on;

% PROGRAM 8: POYNTING VECTOR SIMULATION (SCILAB)
clc;
clear;
clf;
E0=10;
eta=377;
H0=E0/eta;
f=1e9;
omega=2*%pi*f;
t=0:1e-11:5e-9;
E=E0*cos(omega*t);
H=H0*cos(omega*t);
S=E.*H;
Savg=E0*H0/2;
disp("Electric field amplitude E0 = "+string(E0)+" V/m");
disp("Magnetic field amplitude H0 = "+string(H0)+" A/m");
disp("Average Poynting vector = "+string(Savg)+" W/m^2");
subplot(3,1,1);
plot(t*1e9,E);
xlabel("Time (ns)");
ylabel("E (V/m)");
title("Electric Field");
subplot(3,1,2);
plot(t*1e9,H);
xlabel("Time (ns)");
ylabel("H (A/m)");
title("Magnetic Field");
subplot(3,1,3);
plot(t*1e9,S);
xlabel("Time (ns)");
ylabel("S (W/m^2)");
title("Instantaneous Poynting Vector");